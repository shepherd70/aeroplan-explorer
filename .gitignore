# Secrets — never commit your API key
.env

# Local data cache — the live pull (large; regenerate with `node ingest.mjs`).
# sample-cache.json IS committed so a fresh clone can preview offline
# (regenerate it with `node make-sample.mjs`).
aeroplan-cache.json
# trips.cache.json (itinerary detail from `node detail.mjs`) is covered by *.cache.json below.
*.cache.json
!sample-cache.json

# OS / editor cruft
.DS_Store
Thumbs.db
node_modules/

# Scheduled-refresh output (see README → "Keeping it fresh")
*.log

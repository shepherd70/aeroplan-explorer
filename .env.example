# Copy this file to ".env" and paste your keys. The .env file is gitignored — never commit it.

# Required — seats.aero Pro API key (award availability).
# Generate it from your seats.aero account settings (Pro plan required).
SEATS_AERO_KEY=your_key_here

# Optional — Amadeus Self-Service credentials (cash fares for true cents-per-point).
# Free signup at https://developers.amadeus.com → create an app → copy its key/secret.
# Only needed if you run "node enrich-fares.mjs".
AMADEUS_CLIENT_ID=your_amadeus_key
AMADEUS_CLIENT_SECRET=your_amadeus_secret
# Use the full-data production host instead of the free test host (paid past a free quota):
# AMADEUS_HOSTNAME=api.amadeus.com
